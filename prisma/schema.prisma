// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//// Enums ///////////////////////////////////////////////////////////////

enum RewardType {
  CASHBACK
  TRAVEL
  MISCELLANEOUS 
}

enum Category {
  groceries
  dining
  gas
  transit
  travel
  online
  general
  utilities
  streaming
  drugstore
  entertainment
}

enum CardNetwork {
  VISA
  MASTERCARD
  AMEX
  DISCOVER
}

enum SwitchJobStatus {
  pending
  running
  done
  failed
}

enum SwitchEventStatus {
  queued
  in_progress
  updated
  error
}

enum AuditArtifactType {
  CSV
  JSON
  PDF
}

enum BonusKind {
  WELCOME
  UPGRADE
  REFERRAL
  TARGETED
  OTHER
}

enum ForeignTxnType {
  NONE
  PERCENT
}

enum PlaidItemStatus {
  ACTIVE
  LOGIN_REQUIRED
  ERROR
  DISCONNECTED
}
//// Core user ///////////////////////////////////////////////////////////

model Profile {
  userId    String   @id @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User information
  firstName          String?
  lastName           String?
  phone              String?
  creditHistoryAge   String?
  creditScore        Int?
  knowsCreditScore   Boolean?

  // Financial goals
  travelGoal         String? // yes/no/maybe
  diningGoal         String?
  buildCreditGoal    String?
  cashbackGoal       String?
  onlineShoppingGoal String?

  prefs                  UserPrefs?
  userCards              UserCard[]
  userMerchants          UserMerchant[]
  spendProfileMonthly    SpendProfileMonthly[]
  merchantProfileMonthly MerchantProfileMonthly[]
  recRuns                RecommendationRun[]
  bonusProgress          BonusProgress[]
  switchJobs             SwitchJob[]
  plaidItems             PlaidItem[]

  @@index([createdAt])
}

model UserPrefs {
  userId             String         @id @db.Uuid
  creditScore        Int            @default(0)
  creditHistoryYears Int            @default(0)
  maxActiveCards     Int            @default(2)
  annualFeeCapCents  Int            @default(0)
  preference         RewardType @default(CASHBACK)
  allowAnnualFees    Boolean        @default(true)

  user Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

//// Aggregates (no raw transactions persisted) /////////////////////////

model SpendProfileMonthly {
  userId      String   @db.Uuid
  month       DateTime @db.Date // first day of month
  category    Category
  amountCents Int

  user Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, month, category])
  @@index([userId, month])
}

model MerchantProfileMonthly {
  userId      String   @db.Uuid
  month       DateTime @db.Date
  merchant    String
  category    Category
  amountCents Int

  user Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, month, merchant, category])
  @@index([userId, month])
  @@index([userId, merchant])
}

//// Catalog (normalized) ///////////////////////////////////////////////

model CardsCatalog {
  id              String      @id @default(uuid())
  name            String
  issuer          String
  network         CardNetwork
  RewardType      RewardType?
  ImageURL	  String?
  isChargeCard    Boolean     @default(false)
  annualFeeCents  Int         @default(0)
  feeCreditsCents Int         @default(0)
  minCreditScore  Int?        @default(0)
  valuationCpp    Decimal?    @db.Decimal(6, 3)
  active          Boolean     @default(true)

  currencyProgram String?
  sourceUrl       String?
  termsUrl        String?
  lastVerifiedAt  DateTime?
  cardMetadata    Json?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  earnRates        CardEarnRate[]
  bonuses          CardBonus[]
  pacing           CardPacing?
  apr              CardAPR?
  fees             CardFees?
  eligibility      CardEligibility?
  benefits         CardBenefit[]
  partners         CardTransferPartner[]
  rotating         CardRotatingSchedule[]
  assets           CardAsset[]

  userCards        UserCard[]
  bonusProgress    BonusProgress[]
  recPicks         RecommendationPick[]
  routingAsNewCard RoutingRecommendation[] @relation("RoutingNewCard")

  @@unique([issuer, name])
  @@index([active])
  @@index([issuer])
  @@index([network])
}

model CardEarnRate {
  id                String    @id @default(uuid())
  cardId            String
  category          Category
  ratePct           Decimal   @db.Decimal(6, 4)
  // NEW
  capAmountCents    Int?
  capWindowMonths   Int?
  merchantsInclude  Json?
  note              String?
  isRotating        Boolean   @default(false)

  card CardsCatalog @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@index([cardId])
}

model CardBonus {
  id            String @id @default(uuid())
  cardId        String
  kind		BonusKind @default(WELCOME)
  points        Int? // either points or cashCents
  cashCents     Int?
  windowMonths  Int // e.g., 3
  minSpendCents Int
  
  expirationText String?
  footnotes      String[] 

  card CardsCatalog @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, kind])
}

model CardPacing {
  cardId                 String @id
  minDaysBetweenNewCards Int    @default(90)

  card CardsCatalog @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model CardAPR {
  cardId               String  @id
  purchaseAPRMinPct    Decimal? @db.Decimal(5, 2)
  purchaseAPRMaxPct    Decimal? @db.Decimal(5, 2)
  purchaseAPRType      String?
  indexName            String?
  btAPRMinPct          Decimal? @db.Decimal(5, 2)
  btAPRMaxPct          Decimal? @db.Decimal(5, 2)
  introBtPct           Decimal? @db.Decimal(5, 2)
  introBtMonths        Int?
  introBtFeePct        Decimal? @db.Decimal(5, 2)
  introBtFeeMinCents   Int?
  cashAdvanceAPR       Decimal? @db.Decimal(5, 2)
  penaltyAPR           Decimal? @db.Decimal(5, 2)
  card CardsCatalog @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model CardFees {
  cardId                     String @id
  foreignTransactionType     ForeignTxnType @default(NONE)
  foreignTransactionPct      Decimal? @db.Decimal(5, 2)
  balanceTransferFeePct      Decimal? @db.Decimal(5, 2)
  balanceTransferFeeMinCents Int?
  cashAdvanceFeePct          Decimal? @db.Decimal(5, 2)
  cashAdvanceFeeMinCents     Int?
  lateFeeCents               Int?
  returnedPaymentFeeCents    Int?

  card CardsCatalog @relation(fields: [cardId], references: [id], onDelete: Cascade)
}


model CardBenefit {
  id       String  @id @default(uuid())
  cardId   String
  label    String
  section  String?
  priority Int?
  card CardsCatalog @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@index([cardId])
}


model CardEligibility {
  cardId                String @id
  suggestedHistoryYears Int?
  utilizationNote       String?
  otherNotes            String[]
  card CardsCatalog @relation(fields: [cardId], references: [id], onDelete: Cascade)
}


model CardTransferPartner {
  id         String   @id @default(uuid())
  cardId     String
  program    String
  ratioFrom  Int?
  ratioTo    Int?
  multiplier Decimal? @db.Decimal(6, 3)
  note       String?
  card CardsCatalog @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@index([cardId, program])
}


model CardRotatingSchedule {
  id           String   @id @default(uuid())
  cardId       String
  scheduleNote String?
  year         Int?
  quarter      Int?
  categories   String[]
  card CardsCatalog @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@index([cardId, year, quarter])
}

model CardAsset {
  id         String  @id @default(uuid())
  cardId     String
  cardArtUrl String?
  card CardsCatalog @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@index([cardId])
}


//// User wallet and merchants /////////////////////////////////////////

model UserCard {
  id             String       @id @default(uuid())
  userId         String       @db.Uuid
  cardCatalogId  String?
  issuer         String?
  network        CardNetwork?
  last4          String?
  annualFeeCents Int          @default(0)
  active         Boolean      @default(true)
  openedAt       DateTime?

  user    Profile       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  catalog CardsCatalog? @relation(fields: [cardCatalogId], references: [id])

  @@index([userId])
  @@index([cardCatalogId])
}

model UserMerchant {
  id             String   @id @default(uuid())
  userId         String   @db.Uuid
  name           String
  knotMerchantId String?
  connected      Boolean  @default(true)
  createdAt      DateTime @default(now())

  user         Profile       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  switchEvents SwitchEvent[]

  @@index([userId])
  @@index([knotMerchantId])
}

//// Recommendations + routing (auditable runs) /////////////////////////

model RecommendationRun {
  id                  String   @id @default(uuid())
  userId              String   @db.Uuid
  createdAt           DateTime @default(now())
  inputsVersion       String? // e.g., hash of prefs+profile+catalog version
  inputsJson          Json // profile, prefs snapshot
  baselineValueCents  Int
  optimizedValueCents Int

  user   Profile                 @relation(fields: [userId], references: [userId], onDelete: Cascade)
  picks  RecommendationPick[]
  routes RoutingRecommendation[]

  @@index([userId, createdAt])
}

model RecommendationPick {
  id            String  @id @default(uuid())
  runId         String
  cardCatalogId String
  applyAtMonth  Int     @default(0)
  fyvCents      Int
  netFeeCents   Int
  minSpendCents Int
  windowMonths  Int
  feasible      Boolean @default(true)

  run  RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  card CardsCatalog      @relation(fields: [cardCatalogId], references: [id], onDelete: Restrict)

  @@index([runId])
  @@index([cardCatalogId])
}

model RoutingRecommendation {
  id               String   @id @default(uuid())
  runId            String
  merchant         String
  category         Category
  currentCardName  String?
  newCardCatalogId String?
  deltaCents       Int

  run     RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  newCard CardsCatalog?     @relation("RoutingNewCard", fields: [newCardCatalogId], references: [id])

  @@index([runId])
  @@index([merchant])
}

//// Bonus tracking /////////////////////////////////////////////////////

model BonusProgress {
  userId        String   @db.Uuid
  cardCatalogId String
  windowStart   DateTime @db.Date
  spentCents    Int      @default(0)
  targetCents   Int

  user Profile      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  card CardsCatalog @relation(fields: [cardCatalogId], references: [id], onDelete: Restrict)

  @@id([userId, cardCatalogId, windowStart])
  @@index([userId, windowStart])
}

//// Knot switching lifecycle //////////////////////////////////////////

model SwitchJob {
  id           String          @id @default(uuid())
  userId       String          @db.Uuid
  status       SwitchJobStatus @default(pending)
  createdAt    DateTime        @default(now())
  targetCardId String? // optional: which card to set on file (catalog or user card)
  note         String?

  user      Profile               @relation(fields: [userId], references: [userId], onDelete: Cascade)
  events    SwitchEvent[]
  artifacts SwitchAuditArtifact[]

  @@index([userId, createdAt])
}

model SwitchEvent {
  id          String            @id @default(uuid())
  jobId       String
  merchantId  String
  status      SwitchEventStatus
  detailsJson Json?
  ts          DateTime          @default(now())

  job      SwitchJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  merchant UserMerchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([jobId, ts])
  @@index([merchantId])
}

model SwitchAuditArtifact {
  id          String            @id @default(uuid())
  jobId       String
  kind        AuditArtifactType
  payloadJson Json
  createdAt   DateTime          @default(now())

  job SwitchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

//// Plaid Integration //////////////////////////////////////////////////

model PlaidItem {
  id                  String          @id @default(uuid())
  userId              String          @db.Uuid
  accessToken         String          @unique // Encrypted in production
  itemId              String          @unique
  institutionId       String?
  institutionName     String?
  status              PlaidItemStatus @default(ACTIVE)
  errorCode           String?
  lastSuccessfulUpdate DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user         Profile          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  accounts     PlaidAccount[]
  transactions PlaidTransaction[]

  @@index([userId])
  @@index([itemId])
  @@index([status])
}

model PlaidAccount {
  id              String   @id @default(uuid())
  plaidItemId     String
  accountId       String   @unique // Plaid's account_id
  name            String
  officialName    String?
  type            String   // depository, credit, loan, investment
  subtype         String?  // checking, savings, credit card, etc.
  mask            String?  // Last 4 digits
  currentBalance  Int?     // In cents
  availableBalance Int?    // In cents
  isoCurrencyCode String   @default("USD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plaidItem    PlaidItem          @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  transactions PlaidTransaction[]

  @@index([plaidItemId])
  @@index([accountId])
}

model PlaidTransaction {
  id                  String   @id @default(uuid())
  plaidItemId         String
  plaidAccountId      String
  transactionId       String   @unique // Plaid's transaction_id
  amount              Int      // In cents (positive = outflow, negative = inflow)
  isoCurrencyCode     String   @default("USD")
  date                DateTime @db.Date
  authorizedDate      DateTime? @db.Date
  name                String   // Merchant name
  merchantName        String?
  category            String[] // Plaid's category array
  categoryId          String?
  pending             Boolean  @default(false)
  paymentChannel      String?  // online, in store, etc.
  transactionType     String?  // place, digital, special, unresolved
  personalFinanceCategory Json? // Detailed category from Plaid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  plaidItem    PlaidItem    @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  plaidAccount PlaidAccount @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)

  @@index([plaidItemId])
  @@index([plaidAccountId])
  @@index([transactionId])
  @@index([date])
  @@index([merchantName])
}

